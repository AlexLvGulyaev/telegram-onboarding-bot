# Telegram Onboarding Bot — переменные окружения.
# Скопируйте в .env и заполните своими значениями. .env не коммитится.

# --- Telegram ---
BOT_TOKEN=your_telegram_bot_token

# --- База данных (PostgreSQL) ---
# В docker compose используется сервис `db`. При внешней БД укажите её URL.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/onboarding

# --- OpenAI API ---
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Доступ администратора ---
# Telegram user ID, которому доступны команды управления темами
# (/new_topic, /list_topics, /set_topic, /delete_topic). См. docs/OPERATOR_GUIDE.md.
ADMIN_USER_ID=your_telegram_user_id

# --- Тема обучения ---
# id темы-заготовки из каталога topics/ (сидируется в БД при старте).
# Применяется ТОЛЬКО при первом старте, пока в БД нет активной темы.
# На работающей системе активная тема меняется через /set_topic (см. docs/OPERATOR_GUIDE.md).
ACTIVE_TOPIC=onboarding

# --- Промпты ---
PROMPTS_DIR=prompts

# --- Параметры обучения ---
QUIZ_QUESTION_COUNT=5

# --- Логирование (DEBUG / INFO / WARNING / ERROR) ---
LOG_LEVEL=INFO