# Telegram Onboarding Bot — переменные окружения.
# Скопируйте в .env и заполните своими значениями. .env не коммитится.

# --- Telegram ---
BOT_TOKEN=your_telegram_bot_token

# --- База данных (PostgreSQL) ---
# В docker compose используется сервис `db`. При внешней БД укажите её URL.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/onboarding

# --- OpenAI API ---
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Retry при недоступности OpenAI API (429 / 5xx / сетевые сбои) ---
# OPENAI_MAX_RETRIES — число попыток (1–10, по умолчанию 3).
# OPENAI_RETRY_BACKOFF — база экспоненциальной задержки в секундах
# (по умолчанию 1.5: ~1.5s, 2.25s, 3.4s… + джиттер; заголовок Retry-After приоритетнее).
# Клиентские ошибки (400/401/403) не ретраятся. После исчерпания попыток
# диалог сохраняется, пользователь получает сообщение о временном сбое.
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_BACKOFF=1.5

# --- FSM-хранилище сессий (Redis) ---
# Активные сессии обучения переживают рестарт контейнера бота.
# Оставьте как в примере для docker compose (сервис `redis`).
# Пустое значение Redis_URL= — в памяти (MemoryStorage, dev-режим: сессии
# теряются при рестарте).
REDIS_URL=redis://redis:6379/0

# --- Доступ администратора ---
# Telegram user ID, которому доступны команды управления темами
# (/new_topic, /import_topic, /list_topics, /set_topic, /delete_topic). См. docs/OPERATOR_GUIDE.md.
ADMIN_USER_ID=your_telegram_user_id

# --- Тема обучения ---
# id темы, которая станет активной при первом старте (пока в БД нет активной темы).
# Тема с этим id ДОЛЖНА быть в БД — загрузите её через /import_topic (из topics/*.json)
# или /new_topic после первого запуска. Если тема отсутствует в БД, main.py сбросит
# ACTIVE_TOPIC и запишет предупреждение в лог, бот стартует без активной темы.
# На работающей системе активная тема меняется через /set_topic (см. docs/OPERATOR_GUIDE.md).
ACTIVE_TOPIC=onboarding

# --- Промпты ---
PROMPTS_DIR=prompts

# --- Параметры обучения ---
QUIZ_QUESTION_COUNT=5

# --- Логирование (DEBUG / INFO / WARNING / ERROR) ---
LOG_LEVEL=INFO